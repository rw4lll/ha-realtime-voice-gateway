# Home Assistant Realtime Voice Gateway Configuration
# ===========================================================================
# NEW: YAML-based configuration is now the primary configuration method!
# This .env file provides a simpler way to override settings for development.
#
# Quick Start:
#   1. Copy ha-config.yaml.example to ha-config.yaml
#   2. Edit ha-config.yaml with your settings
#   3. Use this .env file only for sensitive data or quick overrides
#
# Priority: Environment variables > YAML config > Defaults
# ===========================================================================

# ===== Configuration File =====
# Path to YAML configuration file (default: ha-config.yaml)
# Set to empty to disable YAML and use only environment variables
HA_CONFIG_FILE=ha-config.yaml

# ===== Home Assistant (Quick Override) =====
# These override settings in ha-config.yaml
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here

# ===== LLM Backend (Quick Override) =====
BACKEND_TYPE=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Advanced: Environment-Only Configuration =====
# If you prefer not to use YAML, uncomment and configure these:

# Home Assistant Discovery
# HA_DISCOVERY_INCLUDE=light,switch,climate,cover
# HA_DISCOVERY_EXCLUDE=automation,script,scene,group,zone,person
# HA_SERVICE_PATTERNS=light.*,switch.*,climate.*

# System Prompt
# HA_PROMPT_ENTITIES=true
# HA_PROMPT_ATTRIBUTES=false

# ===== WebSocket Server =====
# WebSocket server settings (devices connect here)
# The WebSocket server is always enabled - it's the gateway's core purpose
# WEBSOCKET_ADDR=0.0.0.0:8080
# WEBSOCKET_PATH=/voice-stream
# WEBSOCKET_READ_TIMEOUT=60    # seconds
# WEBSOCKET_WRITE_TIMEOUT=10   # seconds
# WEBSOCKET_MAX_BUFFER_SIZE=32768  # bytes (32KB)

# ===== Session Management =====
# Maximum session duration (safety timeout to prevent runaway sessions)
# SESSION_SAFETY_TIMEOUT=5m

# Silence timeout after backend response (ends session after this much silence)
# SESSION_SILENCE_TIMEOUT=3s

# Audio buffer duration before starting playback (prevents premature audio start)
# SESSION_AUDIO_BUFFER_MS=500

# ===== Audio Processing =====
# Audio resampling (for sample rate conversion between backend and device)
# The gateway automatically handles sample rate mismatches (e.g., Gemini outputs 24kHz, device expects 16kHz)

# Enable/disable resampling (auto = enable only when needed, recommended)
# AUDIO_RESAMPLING_ENABLED=auto   # Options: auto, true, false (default: auto)

# Resampling algorithm (fast = optimized for 24kHz→16kHz, linear = any rate)
# AUDIO_RESAMPLING_ALGORITHM=fast  # Options: fast, linear, cubic (default: fast)

# Target device sample rate in Hz (ESP32 Voice Preview uses 16kHz)
# AUDIO_RESAMPLING_TARGET_RATE=16000  # Default: 16000 (ESP32 devices)

# ===== Backend Settings =====
# Gemini Settings
# GEMINI_MODEL=gemini-2.0-flash-exp
# GEMINI_CONNECT_TIMEOUT=30s
# GEMINI_MAX_SESSIONS=5

# Gemini VAD (Voice Activity Detection) Configuration
# Controls Gemini's built-in interruption detection and turn-taking behavior
# These settings help tune the assistant's responsiveness to user speech

# Disable Gemini's VAD entirely (not recommended unless implementing custom VAD)
# GEMINI_VAD_DISABLED=false

# Start-of-speech sensitivity (low = less sensitive, high = more sensitive)
# High: Detects speech faster but may trigger on noise (use in quiet environments)
# Low: More conservative detection, reduces false positives (use in noisy environments)
# GEMINI_VAD_START_SENSITIVITY=high

# End-of-speech sensitivity (low = waits longer, high = ends faster)
# High: Cuts off faster when you stop talking (more responsive but may interrupt)
# Low: Waits longer to ensure you're done speaking (more natural but slower)
# GEMINI_VAD_END_SENSITIVITY=low

# Audio padding before detected speech (milliseconds)
# Captures audio BEFORE speech is detected (helps with cut-off words)
# Recommended: 200-400ms for natural speech capture
# GEMINI_VAD_PREFIX_PADDING_MS=300

# Silence duration to confirm end of speech (milliseconds)
# How long to wait in silence before considering speech ended
# Recommended: 400-700ms (shorter = faster responses, longer = fewer interruptions)
# GEMINI_VAD_SILENCE_DURATION_MS=500

# Activity handling - how Gemini responds when user starts speaking
# start_interrupts: User speech interrupts Gemini's response (natural conversation)
# no_interruption: Gemini finishes speaking before processing user input
# GEMINI_ACTIVITY_HANDLING=start_interrupts

# Turn coverage - what audio to include in conversation turns
# only_activity: Include only detected speech activity (cleaner, faster)
# all_input: Include all audio input (more context, but slower)
# GEMINI_TURN_COVERAGE=only_activity

# OpenAI Settings (if using OpenAI backend)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-realtime-preview

# ===== Logging =====
# LOG_LEVEL=info  # debug, info, warn, error
# LOG_FORMAT=console  # console, json

# ===== Performance =====
# AUDIO_BUFFER_SIZE=100
# EVENT_BUFFER_SIZE=50

# ===== Observability =====
# METRICS_ENABLED=false
# METRICS_ADDR=0.0.0.0:9090
# HEALTH_CHECK_ENABLED=true
# HEALTH_CHECK_ADDR=0.0.0.0:8081
